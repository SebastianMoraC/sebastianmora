---
import '../styles/global.css';
import { SITE } from '../consts';
import { site, social } from '../data/site';
import CursorSpotlight from '../components/react/CursorSpotlight';
import ThemeToggle from '../components/react/ThemeToggle';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  ogImage?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  pathname = Astro.url.pathname,
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(pathname, Astro.site ?? SITE.url).toString();
const og = new URL(ogImage, Astro.site ?? SITE.url).toString();

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: SITE.url,
  image: new URL('/apple-touch-icon.png', SITE.url).toString(),
  email: site.email,
  worksFor: { '@type': 'Organization', name: site.company },
  address: { '@type': 'PostalAddress', addressLocality: 'Pereira', addressCountry: 'CO' },
  sameAs: [social.linkedin, social.github, social.twitter],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SebastianMoraCa" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Apply persisted theme before paint to avoid FOUC. Default is dark;
      // only switch to light if the user explicitly chose it.
      (function () {
        try {
          if (localStorage.getItem('pf-theme') === 'light') {
            document.documentElement.classList.add('is-light');
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="pf-grain" aria-hidden="true"></div>
    <CursorSpotlight client:load />
    <ThemeToggle client:load />

    <slot />
    <Analytics />
  </body>
</html>
