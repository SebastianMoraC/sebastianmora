---
import { talks } from '../../data/talks';
import SectionHead from './SectionHead.astro';
---

<section id="speaking" class="pf-section">
  <SectionHead num="04" title="Speaking & Community" />
  <div class="pf-talks">
    {
      talks.map((t) =>
        t.href ? (
          <a
            class="pf-talk pf-talk-link"
            href={t.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="pf-talk-meta">
              <span class="pf-talk-event">{t.event}</span>
              <span>{t.date} · {t.kind}</span>
            </div>
            <div class="pf-talk-title">{t.title} <span class="pf-talk-arrow">↗</span></div>
            {t.description && <p class="pf-talk-description">{t.description}</p>}
          </a>
        ) : (
          <article class="pf-talk">
            <div class="pf-talk-meta">
              <span class="pf-talk-event">{t.event}</span>
              <span>{t.date} · {t.kind}</span>
            </div>
            <div class="pf-talk-title">{t.title}</div>
            {t.description && <p class="pf-talk-description">{t.description}</p>}
          </article>
        )
      )
    }
  </div>
</section>
