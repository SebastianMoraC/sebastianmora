---
import { site } from '../../data/site';
import SectionHead from './SectionHead.astro';
---

<section id="about" class="pf-section">
  <SectionHead num="01" title="About" />
  <div class="pf-about-grid">
    <div class="pf-about">
      {site.about.map((p) => <p>{p}</p>)}
    </div>
    <div class="pf-photo">
      <img src="/assets/sebastian.jpeg" alt="Sebastián Mora Carmona" loading="lazy" decoding="async" />
    </div>
  </div>
</section>
