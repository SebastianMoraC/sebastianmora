---
type IconName =
  | 'arrow'
  | 'sun'
  | 'moon'
  | 'linkedin'
  | 'github'
  | 'twitter'
  | 'mail'
  | 'book'
  | 'music'
  | 'code'
  | 'spark'
  | 'triangle';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 24 } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && (
    <path
      d="M7 17L17 7M9 7h8v8"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    />
  )}
  {name === 'sun' && (
    <g stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </g>
  )}
  {name === 'moon' && (
    <path
      d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      stroke="currentColor"
      stroke-width="1.5"
      fill="none"
      stroke-linejoin="round"
    />
  )}
  {name === 'linkedin' && (
    <path
      d="M4.98 3.5C4.98 4.881 3.87 6 2.5 6S.02 4.881.02 3.5C.02 2.12 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v15.5H.22V8zm7.61 0h4.36v2.12h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 6.99V23.5h-4.55v-7.6c0-1.81-.03-4.14-2.52-4.14-2.52 0-2.91 1.97-2.91 4v7.74H7.83V8z"
      fill="currentColor"
    />
  )}
  {name === 'github' && (
    <path
      d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.39 2.88-.39s1.96.13 2.88.39c2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"
      fill="currentColor"
    />
  )}
  {name === 'twitter' && (
    <path
      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644z"
      fill="currentColor"
    />
  )}
  {name === 'mail' && (
    <g stroke="currentColor" stroke-width="1.5" fill="none">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="M3 7l9 6 9-6" />
    </g>
  )}
  {name === 'book' && (
    <path
      d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4V4zm16 0h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7V4z"
      stroke="currentColor"
      stroke-width="1.4"
      fill="none"
      stroke-linejoin="round"
    />
  )}
  {name === 'music' && (
    <g stroke="currentColor" stroke-width="1.4" fill="none">
      <circle cx="6" cy="18" r="2.5" />
      <circle cx="17" cy="16" r="2.5" />
      <path d="M8.5 18V5l11-2v13" />
    </g>
  )}
  {name === 'code' && (
    <path
      d="M16 18l6-6-6-6M8 6l-6 6 6 6"
      stroke="currentColor"
      stroke-width="1.6"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
  {name === 'spark' && (
    <path
      d="M12 2v6m0 8v6m10-10h-6M8 12H2m15.07-7.07l-4.24 4.24M9.17 14.83L4.93 19.07m14.14 0l-4.24-4.24M9.17 9.17L4.93 4.93"
      stroke="currentColor"
      stroke-width="1.4"
      fill="none"
      stroke-linecap="round"
    />
  )}
  {name === 'triangle' && (
    <path d="M12 4l9 16H3z" fill="currentColor" />
  )}
</svg>
